# Good picks (JSON mode + capable): openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=

TAKEDOWN_CONTACT_EMAIL=

# Google Cloud Run deploy (only needed when running deploy/cloudrun/deploy.sh)
GCP_PROJECT=
GCP_REGION=asia-south1
