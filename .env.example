SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/interview_bank
DB_USER=postgres
DB_PASSWORD=postgres
CORS_ALLOWED_ORIGINS=http://localhost:3000

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=interview-bank/1.0 by /u/CHANGE_ME

GROQ_API_KEY=
